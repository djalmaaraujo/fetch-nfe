# Copie para .env e preencha. O .env NÃO vai pro git (está no .gitignore).

# --- Empresa / certificado ---
# CNPJ da empresa (só números ou com máscara, tanto faz)
CNPJ=00000000000000
# UF da empresa (sigla), ex.: SP, MG, RS
UF=SP
# Caminho do certificado A1 DENTRO do container (a pasta ./certs é montada em /certs)
CERT_PATH=/certs/certificado.pfx
# Senha do certificado A1 (segredo — fica só neste arquivo local)
CERT_SENHA=troque-aqui

# --- Comportamento ---
# Ambiente: producao | homologacao
AMBIENTE=producao
# Manifestar ciência da operação (210210) pra liberar o XML completo. 1=sim, 0=não.
MANIFESTAR=1
# Deduplicação por chave de acesso (não rebaixa nem regrava o que já existe). 1=sim.
DEDUP=1

# --- Rotina agendada ---
# Intervalo entre ciclos, em segundos. 3600 = 1h (respeita o cooldown da SEFAZ).
# Use 0 para a rotina rodar UMA vez e sair.
INTERVALO_SEGUNDOS=3600

# --- API ---
# Porta exposta no host para a API.
API_PORT=8000
