# Copie para .env e preencha. O .env NÃO vai pro git (está no .gitignore).
# Empresas/certificados são cadastrados via API (POST /empresas) — não aqui.

# --- Comportamento global ---
# Ambiente SEFAZ: producao | homologacao
AMBIENTE=producao
# Default de manifestação (ciência 210210) para NOVAS empresas. 1=sim, 0=não.
# Pode ser ajustado por empresa via PATCH /empresas/{cnpj}.
MANIFESTAR=1
# Deduplicação por chave de acesso. 1=sim.
DEDUP=1

# --- Scheduler / fila ---
# Intervalo entre ciclos de sincronização, em segundos. 3600 = 1h (cooldown SEFAZ).
# 0 = o worker roda UMA vez (sincroniza tudo + drena a fila) e sai.
INTERVALO_SEGUNDOS=3600
# Intervalo de varredura da fila de manifestação, em segundos.
FILA_INTERVALO_SEGUNDOS=30
# Empresas sincronizadas em paralelo / empresas manifestando em paralelo.
SYNC_WORKERS=4
FILA_WORKERS=4
# Tentativas máximas por manifestação antes de marcar como erro (backoff exponencial).
FILA_MAX_TENTATIVAS=5

# --- API ---
API_PORT=8000

# --- Seed opcional (migração do modo single-empresa antigo) ---
# Se preenchidos e a empresa ainda não existir no banco, ela é cadastrada
# automaticamente na subida. Pode remover depois da primeira subida.
#CNPJ=00000000000000
#UF=SP
#CERT_PATH=/certs/certificado.pfx
#CERT_SENHA=troque-aqui
